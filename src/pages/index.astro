---
import BoardIsland from '../components/BoardIsland';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Splat Board</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #ffffff;
        overflow: hidden;
        font-family:
          system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          sans-serif;
      }
      #board-root {
        position: fixed;
        inset: 0;
        touch-action: none;
      }
    </style>
  </head>
  <body>
    <div id="board-root">
      <BoardIsland client:only="react" />
    </div>
  </body>
</html>
